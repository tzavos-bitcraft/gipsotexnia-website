# Copy to .env for local use; on Vercel set these under Project → Settings → Environment Variables.
# Final public URL (no trailing slash). Falls back to the Vercel production URL.
SITE_URL=
# "true" opens the site to search engines and AI crawlers (removes noindex, opens robots.txt).
ALLOW_INDEXING=false
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Empty = no analytics.
PUBLIC_GA_ID=
