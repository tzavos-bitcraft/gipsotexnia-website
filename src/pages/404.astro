---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
const d = t('el');
const e = t('en');
---

<Base lang="el" page="home" title={d.meta.notFound.title} description={d.meta.notFound.description} altPath="/en/">
  <section class="section">
    <div class="wrap" style="text-align:center">
      <h1>{d.notFound.title}</h1>
      <p>{d.notFound.text}</p>
      <p><a class="btn btn--primary" href="/">{d.notFound.back}</a></p>
      <p lang="en" style="margin-top:32px;color:var(--muted)">{e.notFound.title}. <a href="/en/">{e.notFound.back}</a></p>
    </div>
  </section>
</Base>
