---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
const d = t('el');
const e = t('en');
---

<Base lang="el" page="home" title={d.meta.notFound.title} description={d.meta.notFound.description} altPath="/en/">
  <section class="section">
    <div class="wrap nf">
      <h1>{d.notFound.title}</h1>
      <p>{d.notFound.text}</p>
      <p><a class="btn btn--primary" href="/">{d.notFound.back}</a></p>
      <p lang="en" class="nf-en">{e.notFound.title}. <a href="/en/">{e.notFound.back}</a></p>
    </div>
  </section>
</Base>

<style>
  .nf {
    text-align: center;
  }
  .nf-en {
    margin-top: 32px;
    color: var(--muted);
  }
</style>
