---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { t } from '../i18n/ui';
import { path, type Lang } from '../i18n/routes';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const other: Lang = lang === 'el' ? 'en' : 'el';
const site = Astro.site!;
const crumbs = [
  { name: d.nav.home, href: path('home', lang) },
  { name: d.nav.services, href: path('services', lang) },
];
---

<Base
  lang={lang}
  page="services"
  title={d.meta.services.title}
  description={d.meta.services.description}
  altPath={path('services', other)}
  schema={[breadcrumbSchema(site, crumbs.map((c) => ({ name: c.name, path: c.href }))), faqSchema(d.faq.items)]}
>
  <PageHead title={d.services.pageTitle} lead={d.services.pageLead} crumbs={crumbs} />
  <section class="section section--tight">
    <div class="wrap">
      <ServiceCards lang={lang} level="h2" />
    </div>
  </section>
  <section class="section section--sand">
    <div class="wrap">
      <Faq title={d.faq.title} items={d.faq.items} />
    </div>
  </section>
  <CtaBand lang={lang} place="services-cta" />
</Base>
