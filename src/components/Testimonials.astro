---
import { t } from '../i18n/ui';
import { testimonials } from '../data/testimonials';
import type { Lang } from '../i18n/routes';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).testimonials;
---

<section class="section">
  <div class="wrap">
    <div class="section-head section-head--center">
      <h2>{d.title}</h2>
    </div>
    <ul class="grid grid--3 quotes">
      {
        testimonials.map((q) => (
          <li class="card quote">
            {q.placeholder && <span class="badge">{d.placeholderBadge}</span>}
            <blockquote>
              <p>“{q.text[lang]}”</p>
            </blockquote>
            <p class="who">
              <strong>{q.name}</strong> · {q.area[lang]}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .quotes {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .quote {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .badge {
    align-self: flex-start;
  }
  blockquote {
    margin: 0;
    font-size: 1.08rem;
  }
  blockquote p {
    margin: 0;
  }
  .who {
    margin: auto 0 0;
    color: var(--muted);
  }
</style>
