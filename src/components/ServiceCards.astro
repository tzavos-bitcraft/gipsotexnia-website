---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { services } from '../data/services';
import { photo } from '../data/photos';
import { t } from '../i18n/ui';
import { servicePath, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  /** Heading level of each card title. */
  level?: 'h2' | 'h3';
}
const { lang, level: H = 'h3' } = Astro.props;
const d = t(lang);
---

<ul class="grid grid--3 cards">
  {
    services.map((s) => {
      const p = photo(s.photo);
      return (
        <li class="card service">
          <a href={servicePath(s.key, lang)} class="link">
            <Image src={p.src} alt={p.alt[lang]} widths={[360, 560, 760]} sizes="(min-width: 960px) 360px, (min-width: 640px) 50vw, 100vw" class="thumb" />
            <div class="body">
              <span class="icon">
                <Icon name={s.icon} />
              </span>
              <H class="title">{s.title[lang]}</H>
              {s.confirm && <span class="badge">{d.testimonials.confirmBadge}</span>}
              <p>{s.short[lang]}</p>
              <span class="more">
                {lang === 'el' ? 'Περισσότερα' : 'Learn more'}
                <Icon name="arrow" />
              </span>
            </div>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .service {
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .service:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }
  .thumb {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .body {
    position: relative;
    padding: 34px 24px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .icon {
    position: absolute;
    top: -26px;
    left: 24px;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: var(--green-50);
    color: var(--green-700);
    border: 4px solid var(--card);
  }
  .icon :global(svg) {
    width: 26px;
    height: 26px;
  }
  .title {
    font-size: 1.25rem;
    margin-bottom: 0.4em;
  }
  .badge {
    align-self: flex-start;
    margin-bottom: 8px;
  }
  p {
    color: var(--muted);
    margin-bottom: 16px;
  }
  .more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: var(--green-700);
  }
  .more :global(svg) {
    width: 18px;
    height: 18px;
    transition: transform 0.2s;
  }
  .link:hover .more :global(svg) {
    transform: translateX(4px);
  }
</style>
