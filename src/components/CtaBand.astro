---
import ContactButtons from './ContactButtons.astro';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/routes';
interface Props {
  lang: Lang;
  place: string;
}
const { lang, place } = Astro.props;
const c = t(lang).contactSection;
---

<section class="section cta" id="contact">
  <div class="wrap">
    <div class="box">
      <h2>{c.title}</h2>
      <p class="lead">{c.lead}</p>
      <ContactButtons lang={lang} variant="long" align="center" place={place} />
      <p class="tip">{t(lang).cta.photoTip}</p>
    </div>
  </div>
</section>

<style>
  .box {
    text-align: center;
    background:
      radial-gradient(600px 300px at 10% 0%, rgb(69 185 138 / 0.22), transparent 70%),
      radial-gradient(600px 300px at 100% 100%, rgb(40 150 196 / 0.18), transparent 70%),
      var(--card);
    border-radius: 32px;
    padding: clamp(32px, 6vw, 72px) clamp(20px, 5vw, 64px);
    box-shadow: var(--shadow);
  }
  .lead {
    color: var(--muted);
    font-size: 1.15rem;
    max-width: 52ch;
    margin: 0 auto 28px;
  }
  .tip {
    margin: 20px auto 0;
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 52ch;
  }
</style>
