---
// TikTok + Instagram, driven by content/social.json (see src/lib/social.ts).
// Embeds set third-party cookies, so each one shows a preview first and loads the real
// player only after cookie consent, or when the visitor presses it.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { social } from '../config/site';
import { t } from '../i18n/ui';
import { tiktokFeatured, tiktokLatest, tiktokProfileEmbed, instagramPosts, instagramProfileEmbed } from '../lib/social';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tk = t(lang).tiktok;
const ig = t(lang).instagram;
const cs = t(lang).consent;
---

<section class="section section--white social" id="tiktok">
  <div class="wrap">
    <div class="section-head section-head--center">
      <span class="eyebrow">{social.tiktokHandle}</span>
      <h2>{tk.title}</h2>
      <p>{tk.lead}</p>
      <a class="btn btn--tiktok" href={social.tiktok} target="_blank" rel="noopener">
        <Icon name="tiktok" />
        {tk.follow}
      </a>
    </div>

    {
      tiktokFeatured.length > 0 && (
        <div class="group">
          <h3>{tk.featured}</h3>
          <ul class="reel">
            {tiktokFeatured.map((v, i) => (
              <li>
                <button type="button" class="video-facade" data-embed={v.embed} data-title={v.title || `${tk.embedTitle} ${i + 1}`} data-kind="video" aria-label={`${tk.play} ${i + 1}`}>
                  {v.thumb ? (
                    <Image src={v.thumb} alt="" widths={[300, 480]} sizes="300px" class="thumb" />
                  ) : (
                    <Icon name="tiktok" class="thumb-icon" />
                  )}
                  <span class="play" aria-hidden="true">
                    <Icon name="play" />
                  </span>
                </button>
              </li>
            ))}
          </ul>
          <p class="note">{cs.embedNote}</p>
        </div>
      )
    }

    <div class="group">
      <h3>{tk.latest}</h3>
      {
        tiktokLatest.length > 0 ? (
          <ul class="reel">
            {tiktokLatest.map((v, i) => (
              <li>
                <button type="button" class="video-facade" data-embed={v.embed} data-title={`${tk.embedTitle} ${i + 1}`} data-kind="video" aria-label={`${tk.play} ${i + 1}`}>
                  {v.thumb ? <Image src={v.thumb} alt="" widths={[300, 480]} sizes="300px" class="thumb" /> : <Icon name="tiktok" class="thumb-icon" />}
                  <span class="play" aria-hidden="true">
                    <Icon name="play" />
                  </span>
                </button>
              </li>
            ))}
          </ul>
        ) : (
          <div class="profile-facade profile-facade--tiktok" data-embed={tiktokProfileEmbed} data-title={tk.latestCard} data-kind="tiktok-profile">
            <Icon name="tiktok" />
            <strong>{tk.latestCard}</strong>
            <span>{social.tiktokHandle}</span>
            <button type="button" class="btn btn--sm btn--tiktok">{cs.embedLoad}</button>
            <p class="note">{cs.embedNote}</p>
          </div>
        )
      }
    </div>

    <div class="section-head section-head--center ig-head" id="instagram">
      <span class="eyebrow">{social.instagramHandle}</span>
      <h2>{ig.title}</h2>
      <p>{ig.lead}</p>
      <a class="btn btn--ig" href={social.instagram} target="_blank" rel="noopener">
        <Icon name="instagram" />
        {ig.follow}
      </a>
    </div>
    {
      instagramPosts.length > 0 ? (
        <ul class="reel">
          {instagramPosts.map((u) => (
            <li>
              <div class="profile-facade" data-embed={u} data-title={ig.embedTitle} data-kind="ig-post">
                <Icon name="instagram" />
                <button type="button" class="btn btn--sm btn--ig">{cs.embedLoad}</button>
                <p class="note">{cs.embedNoteIg}</p>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        instagramProfileEmbed && (
          <div class="profile-facade profile-facade--ig" data-embed={instagramProfileEmbed} data-title={ig.latestCard} data-kind="ig-profile">
            <Icon name="instagram" />
            <strong>{ig.latestCard}</strong>
            <span>{social.instagramHandle}</span>
            <button type="button" class="btn btn--sm btn--ig">{cs.embedLoad}</button>
            <p class="note">{cs.embedNoteIg}</p>
          </div>
        )
      )
    }
  </div>
</section>

<script>
  // Swap a preview for the real embed (after consent, or when the visitor presses it).
  const load = (el: HTMLElement, autoplay = false) => {
    const f = document.createElement('iframe');
    // A press on a video preview starts that video.
    f.src = el.dataset.embed! + (autoplay && el.dataset.kind === 'video' ? '&autoplay=1' : '');
    f.title = el.dataset.title ?? '';
    f.loading = 'lazy';
    f.allow = 'encrypted-media; fullscreen; picture-in-picture' + (el.dataset.kind === 'video' ? '; autoplay' : '');
    f.allowFullscreen = true;
    f.className = `embed embed--${el.dataset.kind}`;
    el.replaceWith(f);
  };
  // After consent, profile/post embeds load by themselves. Single videos keep their thumbnail
  // and become the player when pressed (lighter on phones, and it starts playing right away).
  const loadAll = () => document.querySelectorAll<HTMLElement>('.social [data-embed]:not([data-kind="video"])').forEach((el) => load(el));
  if (document.documentElement.dataset.consent === 'granted') loadAll();
  document.addEventListener('consent:granted', loadAll);
  document.querySelector('.social')?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const el = target.closest<HTMLElement>('[data-embed]');
    if (el && (el.tagName === 'BUTTON' || target.closest('button'))) load(el, true);
  });
</script>

<style>
  .btn--tiktok {
    background: #111;
    color: #fff;
  }
  .btn--tiktok:hover {
    color: #fff;
    background: #000;
  }
  .btn--ig {
    background: linear-gradient(45deg, #f09433, #dc2743 50%, #bc1888);
    color: #fff;
  }
  .btn--ig:hover {
    color: #fff;
  }
  .group {
    margin-bottom: 40px;
  }
  .group h3 {
    text-align: center;
    color: var(--muted);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .note {
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    margin: 4px 0 0;
  }
  .reel {
    list-style: none;
    margin: 0;
    padding: 4px 4px 12px;
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  @media (min-width: 1040px) {
    .reel {
      justify-content: center;
      overflow: visible;
    }
  }
  .reel li {
    flex: 0 0 min(300px, 76vw);
    scroll-snap-align: center;
  }

  /* Video preview: real thumbnail + play button. */
  .video-facade {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--ink);
    cursor: pointer;
    box-shadow: var(--shadow);
  }
  .video-facade :global(.thumb) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .video-facade:hover :global(.thumb) {
    transform: scale(1.03);
  }
  .video-facade :global(.thumb-icon) {
    width: 48px;
    height: 48px;
    margin: auto;
    color: #fff;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 68px;
    height: 68px;
    margin: -34px 0 0 -34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: var(--ink);
    box-shadow: var(--shadow-lg);
  }
  .play :global(svg) {
    width: 28px;
    height: 28px;
    margin-left: 4px;
  }

  /* Profile previews (latest videos / Instagram grid). */
  .profile-facade {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-align: center;
    padding: 28px 20px;
    max-width: 600px;
    min-height: 260px;
    margin-inline: auto;
    border-radius: var(--radius);
    background:
      linear-gradient(160deg, rgb(69 185 138 / 0.16), rgb(40 150 196 / 0.12)),
      var(--sand);
  }
  .profile-facade :global(svg) {
    width: 40px;
    height: 40px;
  }
  .profile-facade strong {
    font-size: 1.15rem;
  }
  .profile-facade span {
    color: var(--muted);
  }
  .reel .profile-facade {
    aspect-ratio: 4 / 5.6;
    min-height: 0;
  }

  /* Loaded embeds */
  .social :global(iframe.embed) {
    display: block;
    width: 100%;
    border: 0;
    border-radius: var(--radius);
    background: var(--sand);
  }
  .social :global(iframe.embed--video) {
    aspect-ratio: 9 / 16;
  }
  .social :global(iframe.embed--tiktok-profile) {
    max-width: 640px;
    height: 500px;
    margin-inline: auto;
  }
  .social :global(iframe.embed--ig-profile) {
    max-width: 540px;
    aspect-ratio: 1 / 1.05;
    margin-inline: auto;
  }
  .social :global(iframe.embed--ig-post) {
    aspect-ratio: 4 / 5.6;
  }
  .ig-head {
    margin-top: clamp(48px, 7vw, 88px);
  }
</style>
