---
import Rich from './Rich.astro';
interface Props {
  title: string;
  lead?: string;
  crumbs?: { name: string; href: string }[];
}
const { title, lead, crumbs = [] } = Astro.props;
---

<section class="page-head">
  <div class="wrap">
    {
      crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="crumbs">
          <ol>
            {crumbs.map((c) => (
              <li>
                <a href={c.href}>{c.name}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <h1>{title}</h1>
    {lead && <Rich as="p" class="lead" text={lead} />}
    <slot />
  </div>
</section>

<style>
  .page-head {
    padding: clamp(32px, 6vw, 72px) 0 clamp(24px, 4vw, 40px);
    background: radial-gradient(900px 400px at 90% -20%, var(--green-50), transparent 60%);
  }
  .lead {
    color: var(--muted);
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    max-width: 60ch;
  }
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 12px;
    padding: 0;
    font-size: 0.92rem;
  }
  .crumbs li:not(:last-child)::after {
    content: '›';
    margin-left: 6px;
    color: var(--muted);
  }
</style>
