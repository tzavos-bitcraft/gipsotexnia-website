---
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/routes';
interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang);
---

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h2>{d.why.title}</h2>
    </div>
    <ul class="grid grid--3 why">
      {
        d.why.items.map((i) => (
          <li>
            <span class="ic"><Icon name={i.icon} /></span>
            <div>
              <h3>
                {i.title} {'confirm' in i && i.confirm && <span class="badge">{d.testimonials.confirmBadge}</span>}
              </h3>
              <p>{i.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .ic {
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: var(--card);
    color: var(--green-700);
    box-shadow: var(--shadow);
  }
  .ic :global(svg) {
    width: 26px;
    height: 26px;
  }
  h3 {
    margin-bottom: 0.3em;
  }
  .badge {
    vertical-align: middle;
    margin-left: 4px;
  }
  p {
    color: var(--muted);
    margin: 0;
  }
</style>
