---
import '@fontsource-variable/commissioner';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import { t } from '../i18n/ui';
import { plain } from '../i18n/todo';
import { hreflang, type Lang, type PageKey } from '../i18n/routes';
import { businessSchema, websiteSchema } from '../lib/schema';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
  /** This page's path in the other language. */
  altPath: string;
  image?: string;
  /** Extra JSON-LD objects for this page. */
  schema?: (object | null)[];
}
const { lang, page, title, description, altPath, image = '/og-image.jpg', schema = [] } = Astro.props;
const site = Astro.site!;
const d = t(lang);
const canonical = new URL(Astro.url.pathname, site).href;
const alt = new URL(altPath, site).href;
const elUrl = lang === 'el' ? canonical : alt;
const enUrl = lang === 'en' ? canonical : alt;
const ogImage = new URL(image, site).href;
// The prototype is hidden from search engines until ALLOW_INDEXING=true is set (see README).
const allowIndexing = import.meta.env.ALLOW_INDEXING === 'true';
const jsonLd = [businessSchema(site, lang), websiteSchema(site, lang), ...schema].filter(Boolean);
const desc = plain(description);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{plain(title)}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={hreflang.el} href={elUrl} />
    <link rel="alternate" hreflang={hreflang.en} href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={elUrl} />
    {!allowIndexing && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={d.meta.siteName} />
    <meta property="og:title" content={plain(title)} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'el' ? 'el_GR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'el' ? 'en_US' : 'el_GR'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fbf8f3" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonLd.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{d.nav.skip}</a>
    <Header lang={lang} current={page} altPath={altPath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <FloatingContact lang={lang} />
  </body>
</html>
